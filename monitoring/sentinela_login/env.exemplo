# Modelo de /etc/sentinela-login.env — copie, preencha, chmod 600.
#
# Esta caixa carrega UMA credencial de verdade: a da Resend. Ela so manda
# e-mail. Nenhuma chave do Supabase mora aqui de proposito — uma maquina fora
# da plataforma e menos protegida que ela, e trocar um buraco de observabilidade
# por um buraco de seguranca seria um mau negocio.
#
# A chave anon abaixo NAO e segredo: ela ja vai no bundle publico do front.

SENTINELA_SUPABASE_URL=https://<ref>.supabase.co
SENTINELA_ANON_KEY=<a mesma chave anon que o front usa>
SENTINELA_APP_ORIGIN=https://app.clinbia.ai

SENTINELA_RESEND_KEY=re_...
SENTINELA_EMAIL_PARA=voce@dominio.com

# Opcional, habilita a verificacao 7 (login de verdade). Sem ela a sentinela
# prova que o login esta ALCANCAVEL, nao que ele FUNCIONA.
# Use uma conta dedicada, nunca a sua: ela faz login e logout de verdade (a
# cada 5 min enquanto estiver passando, a cada 1 min enquanto estiver falhando).
# A conta e comum, NUNCA super admin, com tenant proprio e vazio, e esta
# marcada com `profiles.is_internal` para ficar de fora de tudo que medimos.
# A senha NAO mora no repositorio: ela foi entregue a parte e so existe aqui,
# neste arquivo, com chmod 600.
#SENTINELA_EMAIL=sentinela.login@clinvia.com.br
#SENTINELA_SENHA=

# Horario (do relogio da VPS) do e-mail diario de sinal de vida. E ele que
# responde "quem vigia a sentinela?": se nao chegar, ela morreu. Sai todo dia,
# inclusive com falha aberta — ele prova que a SENTINELA esta viva, nao que a
# aplicacao esta.
SENTINELA_DIARIO_HORA=08:00

SENTINELA_ESTADO=/var/lib/sentinela/estado.json
