# Modelo de /etc/sentinela-login.env — copie, preencha, chmod 600.
#
# Uma maquina fora da plataforma e, por definicao, menos protegida que ela.
# Entao ela so carrega o que NAO abre nada:
#
#   SENTINELA_META_TOKEN      token de system user com permissao de ENVIO e mais
#                             nada. No pior caso, manda mensagem pelo numero de
#                             alerta. Ver a lista exata de permissoes no README.
#   SENTINELA_HEARTBEAT_KEY   segredo compartilhado do sinal de vida. Abre UMA
#                             rota, que so escreve linha de heartbeat.
#   SENTINELA_ANON_KEY        a mesma chave publica que ja esta no bundle do
#                             front. Nao e segredo.
#   SENTINELA_SENHA           senha da conta interna da sentinela: admin de um
#                             tenant VAZIO, fora de `admin_users`.
#
# Nenhuma delas le dado de paciente. Trocar o buraco de observabilidade por um
# buraco de seguranca seria um mau negocio.

SENTINELA_SUPABASE_URL=https://<ref>.supabase.co
SENTINELA_ANON_KEY=<a mesma chave anon que o front usa>
SENTINELA_APP_ORIGIN=https://app.clinbia.ai

# --- aviso por WhatsApp, direto pela API oficial da Meta ---------------------
# Sem Supabase no caminho, de proposito: o cenario que a sentinela vigia inclui
# a plataforma estar fora, e um aviso que precise dela morre junto com o que
# deveria denunciar.
SENTINELA_META_PHONE_ID=<phone_number_id do numero de alerta>
SENTINELA_META_TOKEN=<token do system user, so envio>
SENTINELA_WHATSAPP_PARA=5511999999999          # varios numeros: separe por virgula

# --- sinal de vida para a plataforma -----------------------------------------
# O MESMO valor precisa estar no secret `SENTINELA_HEARTBEAT_KEY` das edge
# functions. Se divergir, a function responde 401 e a plataforma passa a acusar
# queda da VPS com a VPS de pe.
SENTINELA_HEARTBEAT_KEY=<segredo compartilhado, gere um e cole nos dois lados>

# --- login de verdade (verificacao 7) ----------------------------------------
# Opcional. Sem ela a sentinela prova que o login esta ALCANCAVEL, nao que ele
# FUNCIONA. Use a conta dedicada, nunca a sua: ela faz login e logout de verdade
# (a cada 5 min enquanto passa, a cada 1 min enquanto falha). E conta comum,
# NUNCA super admin, com tenant proprio e vazio, marcada com `profiles.is_internal`
# para ficar de fora de tudo que medimos. A senha NAO mora no repositorio.
#SENTINELA_EMAIL=sentinela.login@clinvia.com.br
#SENTINELA_SENHA=

SENTINELA_ESTADO=/var/lib/sentinela/estado.json
